+/*
+ * Inferno: filesystem patches that have to land *inside* the seal.
+ *
+ * The manual's "Filesystem Patches" step (disable five launch services in
+ * /System/Library/xpc/launchd.plist, patch the dyld shared cache) is documented
+ * as something you do to the restored image afterwards. From iOS 16/17 that is
+ * too late for anything on the system volume: restored seals it and creates the
+ * com.apple.os.update-<hash> snapshot the kernel roots from, so a post-restore
+ * host edit lands on a live filesystem the guest never reads.
+ *
+ * The last moment the host is handed control while the system volume is still
+ * mutable is the SystemImageRootHash data request that restored raises from
+ * *inside* the seal_system_volume checkpoint: by then the canonical-metadata
+ * (mtree) pass over the volume has finished, and restored is blocked waiting for
+ * our reply, with sealing still to come. Run the patch command there and the
+ * seal is computed over the patched content, so the snapshot contains it.
+ *
+ *   INFERNO_FS_PATCH_CMD=<cmd>          run <cmd> <checkpoint-name> at that point
+ *   INFERNO_FS_PATCH_DATATYPE=<type>    which data request triggers it
+ *                                       (default SystemImageRootHash)
+ *   INFERNO_FS_PATCH_CHECKPOINT=<name>  which checkpoint must be in progress
+ *                                       (default seal_system_volume; empty
+ *                                       disables the gate)
+ *
+ * Both names rather than the numeric checkpoint id, because restored's ids move
+ * between releases while the names have not. On a build that never seals -- iOS
+ * 14, say -- neither the checkpoint nor the data request ever appears, the hook
+ * never fires, and the existing post-restore flow is untouched.
+ */
+static const char* inferno_fs_patch_checkpoint(void)
+{
+	const char* v = getenv("INFERNO_FS_PATCH_CHECKPOINT");
+	return v ? v : "seal_system_volume";
+}
+
+static const char* inferno_fs_patch_datatype(void)
+{
+	const char* v = getenv("INFERNO_FS_PATCH_DATATYPE");
+	return v ? v : "SystemImageRootHash";
+}
+
+/* Name of the checkpoint currently in progress, "" when none. */
+static char inferno_active_checkpoint[128] = "";
+
+static void inferno_run_fs_patch_hook(const char* type)
+{
+	const char* cmd = getenv("INFERNO_FS_PATCH_CMD");
+	const char* gate = inferno_fs_patch_checkpoint();
+	char line[4096];
+	int rc;
+
+	if (!cmd || !*cmd) {
+		return;
+	}
+	if (strcmp(type, inferno_fs_patch_datatype()) != 0) {
+		return;
+	}
+	if (*gate && strcmp(inferno_active_checkpoint, gate) != 0) {
+		logger(LL_DEBUG, "fs-patch hook: %s seen outside checkpoint %s "
+		       "(active: '%s'), not firing\n", type, gate,
+		       inferno_active_checkpoint);
+		return;
+	}
+
+	logger(LL_INFO, "== running filesystem-patch hook before %s: %s %s\n",
+	       *gate ? gate : type, cmd, *gate ? gate : type);
+	snprintf(line, sizeof(line), "'%s' '%s'", cmd, *gate ? gate : type);
+	rc = system(line);
+	if (rc != 0) {
+		logger(LL_ERROR, "== filesystem-patch hook FAILED (%d). The restore "
+		       "continues, but the seal will not contain the patches.\n", rc);
+	} else {
+		logger(LL_INFO, "== filesystem-patch hook done\n");
+	}
+}
