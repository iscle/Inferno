+			plist_dict_set_item(response, response_ticket,
+			                    plist_new_data(tbuf, tlen));
+			free(tbuf);
+			plist_free(request);
+			logger(LL_INFO, "synthesised local %s response (ticket %ld bytes, key '%s')\n",
+			       s_updater_name, tlen, response_ticket);
+			goto have_response;
+		}
+	}
+	{
+		const char *rfile = getenv("INFERNO_CRYPTEX_RESPONSE");
+		if (rfile) {
+			response = NULL;
+			plist_read_from_file(rfile, &response, NULL);
+			plist_free(request);
+			if (response == NULL) {
+				logger(LL_ERROR, "INFERNO_CRYPTEX_RESPONSE set but could not read %s\n", rfile);
+				return NULL;
+			}
+			logger(LL_INFO, "using local %s response from %s\n", s_updater_name, rfile);
+			goto have_response;
+		}
+	}
+
 	logger(LL_INFO, "Sending %s TSS request...\n", s_updater_name);
 	response = tss_request_send(request, client->tss_url);
 	plist_free(request);
