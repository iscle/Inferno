+	/*
+	 * Cryptex1 personalisation against an emulated device.
+	 *
+	 * Apple's TSS will not personalise a forged ECID, so tss_request_send()
+	 * returns NULL, the device never receives a FirmwareResponseData for the
+	 * Cryptex1 updater, and the restore dies at install_splat around 95%.
+	 *
+	 * It does not need a genuine ticket. The device side is
+	 * AMAuthInstallUpdaterCryptex1LocalPolicyStitchTicketData -- it *stitches*
+	 * the returned ticket into the local policy, which is ASN.1 assembly rather
+	 * than a signature check -- and the AP kernel's img4 trust evaluation is
+	 * already bypassed. The response only has to be well formed.
+	 *
+	 *   INFERNO_CRYPTEX_DUMP=<dir>   dump the device-generated request and the
+	 *                                assembled TSS request for inspection. The
+	 *                                request carries the six component digests
+	 *                                and the nonce a ticket has to certify.
+	 *   INFERNO_CRYPTEX_TICKET=<f>   synthesise the response in-process from
+	 *                                that request, wrapping this ticket. Doing
+	 *                                it in-process matters: it collapses a probe
+	 *                                cycle from two full restores to one.
+	 *   INFERNO_CRYPTEX_RESPONSE=<f> use a pre-built response plist instead.
+	 *
+	 * See contrib/inferno-host-restore/add_cryptex_objects.py for building the
+	 * ticket the device will accept.
+	 */
+	{
+		const char *dumpdir = getenv("INFERNO_CRYPTEX_DUMP");
+		if (dumpdir) {
+			char path[1024];
+			snprintf(path, sizeof(path), "%s/cryptex-%s-request.plist", dumpdir, s_updater_name);
+			plist_write_to_file(request, path, PLIST_FORMAT_XML, 0);
+			snprintf(path, sizeof(path), "%s/cryptex-%s-arguments.plist", dumpdir, s_updater_name);
+			plist_write_to_file(arguments, path, PLIST_FORMAT_XML, 0);
+			logger(LL_INFO, "dumped %s request/arguments to %s\n", s_updater_name, dumpdir);
+		}
+	}
+	/*
+	 * INFERNO_CRYPTEX_TICKET_CMD=<cmd>: build the ticket right here, from the
+	 * request the device has just generated.
+	 *
+	 * The digests a Cryptex1 ticket has to certify are computed by the *device*
+	 * and only appear in its DeviceGeneratedRequest, so INFERNO_CRYPTEX_TICKET
+	 * on its own still costs one whole restore to capture them and a second to
+	 * use them -- three hours on this hardware. Running the generator at the
+	 * point the request exists collapses that back to a single restore.
+	 *
+	 * The command is invoked as
+	 *     <cmd> <base-ticket.der> <arguments.plist> <out-ticket.der>
+	 * which is exactly add_cryptex_objects.py's own argument order, so
+	 *     INFERNO_CRYPTEX_TICKET_CMD="contrib/.../add_cryptex_objects.py"
+	 *     INFERNO_CRYPTEX_TICKET=root_ticket.der
+	 * needs no wrapper script. The generated ticket is a local artefact.
+	 */
+	char gen_ticket[1024] = "";
+	{
+		const char *tcmd = getenv("INFERNO_CRYPTEX_TICKET_CMD");
+		const char *base = getenv("INFERNO_CRYPTEX_TICKET");
+		if (tcmd && base) {
+			char argp[1024], outp[1024], cmd[4096];
+			const char *tmpdir = getenv("TMPDIR");
+			if (!tmpdir || !*tmpdir) tmpdir = "/tmp";
+			snprintf(argp, sizeof(argp), "%s/inferno-cryptex-%s-args.plist",
+			         tmpdir, s_updater_name);
+			snprintf(outp, sizeof(outp), "%s/inferno-cryptex-%s-ticket.der",
+			         tmpdir, s_updater_name);
+			if (plist_write_to_file(arguments, argp, PLIST_FORMAT_XML, 0) != PLIST_ERR_SUCCESS) {
+				logger(LL_ERROR, "INFERNO_CRYPTEX_TICKET_CMD: cannot write %s\n", argp);
+				plist_free(request);
+				return NULL;
+			}
+			snprintf(cmd, sizeof(cmd), "'%s' '%s' '%s' '%s'", tcmd, base, argp, outp);
+			logger(LL_INFO, "running cryptex ticket generator: %s\n", cmd);
+			int rc = system(cmd);
+			if (rc != 0) {
+				logger(LL_ERROR, "cryptex ticket generator failed (%d)\n", rc);
+				plist_free(request);
+				return NULL;
+			}
+			/*
+			 * Hand the freshly built ticket to the block below. Deliberately
+			 * NOT via setenv: this function runs once per updater, and
+			 * overwriting INFERNO_CRYPTEX_TICKET would make the next call use
+			 * an already-populated ticket as its base and add the six objects
+			 * twice.
+			 */
+			snprintf(gen_ticket, sizeof(gen_ticket), "%s", outp);
+		}
+	}
+	/*
+	 * INFERNO_CRYPTEX_TICKET=<file>: synthesise the response in-process from the
+	 * device's own request. Echoing the device-generated nonces back is the part
+	 * most likely to decide it, and doing it here avoids a ~90 minute round trip
+	 * through a full ASR write just to author a response file.
+	 */
+	{
+		const char *tfile = gen_ticket[0] ? gen_ticket : getenv("INFERNO_CRYPTEX_TICKET");
+		if (tfile) {
+			FILE *tf = fopen(tfile, "rb");
+			if (!tf) {
+				logger(LL_ERROR, "INFERNO_CRYPTEX_TICKET: cannot open %s\n", tfile);
+				plist_free(request);
+				return NULL;
+			}
+			fseek(tf, 0, SEEK_END);
+			long tlen = ftell(tf);
+			fseek(tf, 0, SEEK_SET);
+			char *tbuf = malloc(tlen);
+			if (!tbuf || fread(tbuf, 1, tlen, tf) != (size_t)tlen) {
+				logger(LL_ERROR, "INFERNO_CRYPTEX_TICKET: cannot read %s\n", tfile);
+				fclose(tf); free(tbuf); plist_free(request); return NULL;
+			}
+			fclose(tf);
+
+			response = plist_new_dict();
+			plist_t st = plist_new_dict();
+			plist_dict_set_item(st, "code", plist_new_uint(0));
+			plist_dict_set_item(st, "message", plist_new_string("SUCCESS"));
+			plist_dict_set_item(response, "Status", st);
+
+			/* Echo the device's own nonce/identity fields back. */
+			/*
+			 * Key names taken from a captured DeviceGeneratedRequest -- the
+			 * cryptex ones contain commas ("Cryptex1,Nonce"), so a list of
+			 * comma-less guesses would silently echo nothing.
+			 */
+			static const char *echo[] = {
+				"Cryptex1,Nonce", "Cryptex1,NonceDomain", "Cryptex1,ChipID",
+				"Cryptex1,Type", "Cryptex1,SubType", "Cryptex1,ProductClass",
+				"Cryptex1,UDID", "Cryptex1,Version", "Cryptex1,ProductionMode",
+				"Cryptex1,PreauthorizationVersion", "ApSecurityDomain",
+				"UniqueBuildID",
+				"ApNonce", "SepNonce", "ApECID", "ApChipID", "ApBoardID",
+				"ApProductionMode", "ApSecurityMode", "Nonce", NULL
+			};
+			plist_t dgr = plist_dict_get_item(arguments, "DeviceGeneratedRequest");
+			for (int e = 0; echo[e]; e++) {
+				plist_t v = NULL;
+				if (dgr) v = plist_dict_get_item(dgr, echo[e]);
+				if (!v) v = plist_dict_get_item(p_info, echo[e]);
+				if (v) plist_dict_set_item(response, echo[e], plist_copy(v));
+			}
