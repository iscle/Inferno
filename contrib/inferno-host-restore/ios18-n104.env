# ios18-n104.env — asset names for iPhone 11 (n104ap / iPhone12,1) on iOS 18.6.2
# (build 22G100).
#
# Source it with `set -a` before run-main-vm.sh / inferno-restore.sh so that an
# 18.6.2 attempt runs out of its own data directory without disturbing the
# working iOS 14.0b5 or 26.5 setups:
#
#   set -a; . contrib/inferno-host-restore/ios18-n104.env; set +a
#   ./contrib/inferno-host-restore/run-main-vm.sh
#
# INFERNO_DATA must already hold the 18.6.2 IPSW extracted into Restore/, freshly
# created disks, and the forged root_ticket.der / repackaged SEP firmware — the
# same File Setup steps as for 14.0b5, run against the 18.6.2 BuildManifest.
#
# Copyright (c) 2026 Inferno host-restore contributors.
# SPDX-License-Identifier: AGPL-3.0-or-later

INFERNO_DATA="${INFERNO_DATA:-$HOME/InfernoData18}"
INFERNO_IPSW="${INFERNO_IPSW:-$HOME/Downloads/iPhone12,1_18.6.2_22G100_Restore.ipsw}"

# Build-specific asset names, from the 18.6.2 BuildManifest's n104ap "Erase"
# identity (Customer Erase Install). Like 26.5 this is a cryptex-era IPSW: the OS
# payload is AEA (043-18757-102.dmg.aea) and there are two cryptex payloads
# (Cryptex1,SystemOS = 043-18359-102.dmg.aea, Cryptex1,AppOS = 043-18958-102.dmg),
# so idevicerestore needs the locally-forged Cryptex1 ticket.
INFERNO_BOARD=n104
INFERNO_KERNEL=Restore/kernelcache.research.iphone12b
INFERNO_DTB=Restore/Firmware/all_flash/DeviceTree.n104ap.im4p
# RestoreRamDisk 043-19142-102.dmg, run through inferno-ramdisk-patcher.py so the
# ramdisk's userland libimage4 trust evaluation returns success — without it the
# restore dies at seal_system_volume with "trust evaluation failed: 80".
INFERNO_RAMDISK=043-19142-102.patched.dmg
INFERNO_TRUSTCACHE=Restore/Firmware/043-19142-102.dmg.trustcache
INFERNO_SEP_FW=sep-firmware.n104.RELEASE.new.img4
INFERNO_SEP_ROM=AppleSEPROM-Cebu-B1
INFERNO_TICKET=root_ticket.der

# Own socket, so an 18.6.2 VM can run alongside the 14.0b5 and 26.5 ones.
INFERNO_USB_CONN_ADDR="${INFERNO_USB_CONN_ADDR:-/tmp/InfernoUSBRemote18}"

# --- filesystem patches, applied inside the seal ---------------------------
# 18.6.2 seals the system volume and boots the com.apple.os.update-<hash>
# snapshot, so the manual's post-restore edit of
# /System/Library/xpc/launchd.plist is invisible to the guest. Set this and
# idevicerestore runs the patcher from inside seal_system_volume instead, so the
# seal — and therefore the snapshot — covers it. Harmless on unsealed builds:
# the checkpoint never appears there, so the hook never fires.
INFERNO_FS_PATCH_CMD="${INFERNO_FS_PATCH_CMD:-$HOME/Inferno/contrib/inferno-host-restore/inferno-preseal-fs-patch.py}"
INFERNO_FS_PATCH_IMAGE="${INFERNO_FS_PATCH_IMAGE:-$INFERNO_DATA/root}"

# After the restore, run-main-vm.sh needs the name of the snapshot to root from;
# a RELEASE kernel panics with "Failed to find the root snapshot" without it.
# Read it off the restored image with:
#   hdiutil attach -imagekey diskimage-class=CRawDiskImage -blocksize 4096 \
#           -noverify -noautofsck -nomount "$INFERNO_DATA/root"
#   diskutil apfs listSnapshots <the System volume's diskNsM>
# then export INFERNO_ROOT_SNAPSHOT=com.apple.os.update-<hash>.
