# ios26-n104.env — asset names for iPhone 11 (n104ap / iPhone12,1) on iOS 26.5
# (build 23F77).
#
# Source it with `set -a` before run-main-vm.sh / inferno-restore.sh so that a
# 26.5 attempt runs out of its own data directory without disturbing the
# working iOS 14.0b5 setup:
#
#   set -a; . contrib/inferno-host-restore/ios26-n104.env; set +a
#   ./contrib/inferno-host-restore/run-main-vm.sh
#
# INFERNO_DATA must already hold the 26.5 IPSW extracted into Restore/, freshly
# created disks, and the forged root_ticket.der / repackaged SEP firmware — the
# same File Setup steps as for 14.0b5, run against the 26.5 BuildManifest.
#
# Copyright (c) 2026 Inferno host-restore contributors.
# SPDX-License-Identifier: AGPL-3.0-or-later

INFERNO_DATA="${INFERNO_DATA:-$HOME/InfernoData26}"
INFERNO_IPSW="${INFERNO_IPSW:-$HOME/Downloads/iPhone12,1_26.5_23F77_Restore.ipsw}"

# Build-specific asset names, taken from the 26.5 BuildManifest's n104ap "Erase"
# build identity. Unlike 14.0b5 the OS payload is an AEA archive
# (094-55773-098.dmg.aea) and there is a second, cryptex payload
# (094-56417-100.dmg.aea) — idevicerestore has to handle both.
INFERNO_BOARD=n104
INFERNO_KERNEL=Restore/kernelcache.research.iphone12b
INFERNO_DTB=Restore/Firmware/all_flash/DeviceTree.n104ap.im4p
INFERNO_RAMDISK=Restore/094-54872-103.dmg
INFERNO_TRUSTCACHE=Restore/Firmware/094-54872-103.dmg.trustcache
INFERNO_SEP_FW=sep-firmware.n104.RELEASE.new.img4
INFERNO_SEP_ROM=AppleSEPROM-Cebu-B1
INFERNO_TICKET=root_ticket.der

# Own sockets, so a 26.5 VM can run alongside the 14.0b5 one.
INFERNO_USB_CONN_ADDR="${INFERNO_USB_CONN_ADDR:-/tmp/InfernoUSBRemote26}"
